{
  "name": "smart-parking-system",
  "version": "1.0.0",
  "description": "智能停车场综合管理系统后端API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --watchAll=false --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --watchAll=false --runInBand --coverage --forceExit",
    "init-data": "node src/scripts/initData.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 60000
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "socket.io": "^4.7.2",
    "node-cron": "^3.0.2",
    "moment": "^2.29.4",
    "joi": "^17.10.0",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "json2csv": "^6.0.0-alpha.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.6",
    "socket.io-client": "^4.7.2"
  }
}

digraph NetworkTopology {
    rankdir=LR;
    node [fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=8];

    n_192_168_1_1 [label="MainRouter\n192.168.1.1\n(router)", shape=ellipse, style=filled, fillcolor="#e74c3c", fontcolor="white", color="#e74c3c"];
    n_192_168_1_2 [label="CoreSwitch\n192.168.1.2\n(switch)", shape=box, style=filled, fillcolor="#3498db", fontcolor="white", color="#3498db"];
    n_192_168_1_3 [label="Server01\n192.168.1.3\n(server)", shape=oval, style=dashed, fillcolor="#2ecc71", fontcolor="white", color="#2ecc71"];

    n_192_168_1_1 -> n_192_168_1_2 [label="LLDP", style=solid, color="#2c3e50", penwidth=2];
    n_192_168_1_1 -> n_192_168_1_3 [label="ARP", style=dashed, color="#95a5a6", penwidth=1];
}
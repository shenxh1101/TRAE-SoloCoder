# AI 菜谱变形记 - 环境配置示例
# 复制此文件为 .env 并填入你的配置

# AI API 配置
# OpenAI 格式示例：https://api.openai.com/v1
# 其他兼容格式（如DeepSeek、Qwen、Zhipu等）：填入对应的API地址
VITE_AI_API_URL=https://api.openai.com/v1

# 你的 API Key
VITE_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用的模型名称
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# DeepSeek: deepseek-chat
# Qwen: qwen-plus, qwen-max
# Zhipu: glm-4-flash, glm-4
VITE_AI_MODEL=gpt-4o-mini